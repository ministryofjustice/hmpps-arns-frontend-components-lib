{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/accordion/macro.njk" import govukAccordion %}

{% set latestAssessment = params.data.assessments | first if params.data.assessments else null %}
{% set forename = params.forename | default('This individual') %}

{% if latestAssessment %}

    {{ govukInsetText({
        text: "Source: " + latestAssessment.assessmentType + " assessment, completed on " + latestAssessment.completedDate
    }) }}

    {#  All reoffending predictor  #}
    {% set allReoffendingPredictorHeadingHtml %}
        <span>All reoffending predictor</span>
    {% endset %}

    {% set allReoffendingPredictorSummaryHtml %}
        <span>All reoffending predictor summary text</span>
    {% endset %}

    {% set allReoffendingPredictorContentHtml %}
        <p>This is the content for the all reoffending predictor.</p>
    {% endset %}


    {#  Violent reoffending predictor  #}
    {% set violentReoffendingPredictorHeadingHtml %}
        <span>Violent reoffending predictor</span>
    {% endset %}

    {% set violentReoffendingPredictorSummaryHtml %}
        <p>Violent reoffending predictor summary text</p>
    {% endset %}

    {% set violentReoffendingPredictorContentHtml %}
        <p>This is the content for the violent reoffending predictor.</p>
    {% endset %}


    {#  Combined serious reoffending predictor  #}
    {% set combinedSeriousReoffendingPredictorHeadingHtml %}
        <span>Combined serious reoffending predictor</span>
    {% endset %}

    {% set combinedSeriousReoffendingPredictorSummaryHtml %}
        <p>Combined serious reoffending predictor summary text</p>
    {% endset %}

    {% set combinedSeriousReoffendingPredictorContentHtml %}
        <p>This is the content for the combined serious reoffending predictor.</p>
    {% endset %}


    {#  Serious violent reoffending predictor  #}
    {% set seriousViolentReoffendingPredictorHeadingHtml %}
        <span>Serious violent reoffending predictor</span>
    {% endset %}

    {% set seriousViolentReoffendingPredictorSummaryHtml %}
        <p>Serious violent reoffending predictor summary text</p>
    {% endset %}

    {% set seriousViolentReoffendingPredictorContentHtml %}
        <p>This is the content for the serious violent reoffending predictor.</p>
    {% endset %}


    {#  Direct contact - Sexual reoffending predictor  #}
    {% set directContactSexualReoffendingPredictorHeadingHtml %}
        <span>Direct contact - Sexual reoffending predictor</span>
    {% endset %}

    {% set directContactSexualReoffendingPredictorSummaryHtml %}
        <p>Direct contact - Sexual reoffending predictor summary text</p>
    {% endset %}

    {% set directContactSexualReoffendingPredictorContentHtml %}
        <p>This is the content for the direct contact - Sexual reoffending predictor.</p>
    {% endset %}


    {#  Images and indirect contact - Sexual reoffending predictor  #}
    {% set imagesAndIndirectContactSexualReoffendingPredictorHeadingHtml %}
        <span>Images and indirect contact - Sexual reoffending predictor</span>
    {% endset %}

    {% set imagesAndIndirectContactSexualReoffendingPredictorSummaryHtml %}
        <p>Images and indirect contact - Sexual reoffending predictor summary text</p>
    {% endset %}

    {% set imagesAndIndirectContactSexualReoffendingPredictorContentHtml %}
        <p>This is the content for the images and indirect contact - Sexual reoffending predictor.</p>
    {% endset %}


    {{ govukAccordion({
        id: "predictor-scores-accordion",
        showSectionText: "Show details",
        hideSectionText: "Hide details",
        showSectionAriaLabelText: "Show this details section",
        hideSectionAriaLabelText: "Hide this details section",
        showAllSectionsText: "Show all details",
        hideAllSectionsText: "Hide all details",
        items: [
            {
                heading: { html: allReoffendingPredictorHeadingHtml },
                summary: { html: allReoffendingPredictorSummaryHtml },
                content: { html: allReoffendingPredictorContentHtml }
            },
            {
                heading: { html: violentReoffendingPredictorHeadingHtml },
                summary: { html: violentReoffendingPredictorSummaryHtml },
                content: { html: violentReoffendingPredictorContentHtml }
            },
            {
                heading: { html: combinedSeriousReoffendingPredictorHeadingHtml },
                summary: { html: combinedSeriousReoffendingPredictorSummaryHtml },
                content: { html: combinedSeriousReoffendingPredictorContentHtml }
            },
            {
                heading: { html: seriousViolentReoffendingPredictorHeadingHtml },
                summary: { html: seriousViolentReoffendingPredictorSummaryHtml },
                content: { html: seriousViolentReoffendingPredictorContentHtml }
            },
            {
                heading: { html: directContactSexualReoffendingPredictorHeadingHtml },
                summary: { html: directContactSexualReoffendingPredictorSummaryHtml },
                content: { html: directContactSexualReoffendingPredictorContentHtml }
            },
            {
                heading: { html: imagesAndIndirectContactSexualReoffendingPredictorHeadingHtml },
                summary: { html: imagesAndIndirectContactSexualReoffendingPredictorSummaryHtml },
                content: { html: imagesAndIndirectContactSexualReoffendingPredictorContentHtml }
            }
        ]
    }) }}

{% endif %}