{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "es2018",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "sourceMap": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "experimentalDecorators": true,
    "typeRoots": ["./src/@types", "./node_modules/@types"],
    "declaration": true
  },
  "exclude": [
    "node_modules",
    "src/assets/**/*.js",
    "integration_tests",
    "dist",
    "cypress.config.ts",
    "**/*.test.ts",
    "**/*.test.js",
    "rollup.config.ts",
    "**/test-utils/**"
  ],
  "include": ["src/**/*.ts"]
}
